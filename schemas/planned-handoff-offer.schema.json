{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://upp.dev/schemas/planned-handoff-offer.schema.json",
  "title": "UPP Authenticated Planned Handoff Offer",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "transactionId",
    "sourceNodeId",
    "targetNodeId",
    "sourceEpoch",
    "targetEpoch",
    "targetShowNs",
    "allowDegradedProgram",
    "issuedAtUnixNs",
    "digestSha256",
    "hmacSha256"
  ],
  "properties": {
    "protocolVersion": {
      "const": 1
    },
    "transactionId": {
      "type": "integer",
      "minimum": 1
    },
    "sourceNodeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "targetNodeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "sourceEpoch": {
      "type": "integer",
      "minimum": 1
    },
    "targetEpoch": {
      "type": "integer",
      "minimum": 2
    },
    "targetShowNs": {
      "type": "integer",
      "minimum": 1
    },
    "allowDegradedProgram": {
      "type": "boolean"
    },
    "issuedAtUnixNs": {
      "type": "integer",
      "minimum": 1
    },
    "digestSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "hmacSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "keyId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9._-]+$"
    }
  }
}
