{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"org.upp.driver-catalog/2",
  "type":"object",
  "required":["documentType","schemaVersion","reviewPolicy","packages"],
  "properties":{
    "documentType":{"const":"org.upp.driver-catalog"},"schemaVersion":{"const":2},
    "reviewPolicy":{"type":"object","required":["catalogClaim","automaticInstallAllowed","qualification"],"properties":{
      "catalogClaim":{"const":"package-metadata-only"},"automaticInstallAllowed":{"const":false},"qualification":{"const":"hardware-tests-required"}
    }},
    "packages":{"type":"array","items":{"type":"object","required":["hardwareId","product","os","osReleases","architecture","publisher","package","version","url","releaseDate","reviewedAt","reviewExpiresAt","reviewConfidence","catalogClaim","evidence"],"properties":{
      "hardwareId":{"type":"string","pattern":"^USB:[0-9A-F]{4}:[0-9A-F]{4}$"},"product":{"type":"string","minLength":1},
      "os":{"enum":["Linux","Windows","Darwin"]},"osReleases":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
      "architecture":{"type":"string","minLength":1},"publisher":{"type":"string","minLength":1},"package":{"type":"string","minLength":1},
      "version":{"type":"string","minLength":1},"url":{"type":"string","pattern":"^https://"},
      "releaseDate":{"type":"string","format":"date"},"reviewedAt":{"type":"string","format":"date"},"reviewExpiresAt":{"type":"string","format":"date"},
      "reviewConfidence":{"enum":["low","moderate","high"]},"catalogClaim":{"const":"package-metadata-only"},
      "evidence":{"type":"array","minItems":2,"items":{"type":"object","required":["kind","url"],"properties":{"kind":{"enum":["vendor-download","hardware-id-source","vendor-support"]},"url":{"type":"string","pattern":"^https://"}}}}
    }}}
  }
}
