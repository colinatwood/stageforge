{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://upp.dev/schemas/midi-mapping-set.schema.json",
  "type":"object",
  "required":["documentType","schemaVersion","revision","mappings"],
  "properties":{
    "documentType":{"const":"org.upp.midi-mapping-set"},
    "schemaVersion":{"const":1},
    "revision":{"type":"integer","minimum":0},
    "mappings":{"type":"array","maxItems":512,"items":{"$ref":"#/$defs/mapping"}}
  },
  "$defs":{
    "mapping":{"type":"object","required":["mappingId","source","target","behavior","quantize","keySync","enabled"],"properties":{
      "mappingId":{"type":"string","minLength":1,"maxLength":128},
      "name":{"type":"string","maxLength":128},
      "source":{"type":"object","required":["deviceId","channel","message","number"],"properties":{"deviceId":{"type":"string","minLength":1,"maxLength":96},"channel":{"type":"integer","minimum":0,"maximum":15},"message":{"enum":["note","cc","pitch-bend","program"]},"number":{"type":"integer","minimum":0,"maximum":127}},"additionalProperties":false},
      "target":{"type":"object","required":["targetId","name","kind"],"properties":{"targetId":{"type":"string","minLength":1,"maxLength":128},"name":{"type":"string","minLength":1,"maxLength":128},"kind":{"enum":["trigger","toggle","continuous","note"]}},"additionalProperties":true},
      "behavior":{"enum":["absolute","relative","trigger","toggle","gate"]},
      "quantize":{"enum":["off","1/4","1/8","1/16","1/32"]},
      "keySync":{"type":"boolean"},"scale":{"enum":["major","minor","chromatic"]},"enabled":{"type":"boolean"}
    },"additionalProperties":true}
  },
  "additionalProperties":false
}
