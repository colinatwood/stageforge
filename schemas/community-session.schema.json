{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://upp.dev/schemas/community-session.schema.json",
  "title": "UPP Community Account Session",
  "type": "object",
  "required": [
    "sessionToken",
    "accountId",
    "authGeneration",
    "sessionId",
    "issuedAtNs",
    "expiresAtNs",
    "expiresInSeconds"
  ],
  "properties": {
    "sessionToken": {"type": "string", "minLength": 80, "maxLength": 2048},
    "accountId": {"type": "string", "minLength": 1, "maxLength": 128},
    "authGeneration": {"type": "integer", "minimum": 1},
    "sessionId": {"type": "string", "pattern": "^community-session-[0-9a-f]{32}$"},
    "issuedAtNs": {"type": "integer", "minimum": 1},
    "expiresAtNs": {"type": "integer", "minimum": 1},
    "expiresInSeconds": {"type": "integer", "minimum": 60, "maximum": 86400}
  },
  "additionalProperties": true
}
