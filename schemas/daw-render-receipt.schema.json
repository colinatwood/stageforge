{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://upp.dev/schemas/daw-render-receipt.schema.json","type":"object","required":["documentType","schemaVersion","sessionId","sessionRevision","outputSha256","sampleRate","bits","frames","limiterGain","dither","physicalOutputsArmed"],"properties":{"documentType":{"const":"org.upp.daw-render-receipt"},"schemaVersion":{"const":1},"outputSha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"sampleRate":{"const":192000},"bits":{"enum":[16,24,32]},"frames":{"type":"integer","minimum":1},"limiterGain":{"type":"number","minimum":0,"maximum":1},"dither":{"enum":["tpdf","none"]},"physicalOutputsArmed":{"const":false}},"additionalProperties":true}
