{
  "version": 1,
  "quorum": 2,
  "maxClockSkewMs": 1000,
  "allowInsecureLoopback": false,
  "witnesses": [
    {
      "url": "https://witness-a.example.net:8790",
      "witnessId": "witness-a",
      "failureDomain": "venue-ups-a",
      "keyringFile": "/etc/stageforge/witness-a-keys.json"
    },
    {
      "url": "https://witness-b.example.net:8790",
      "witnessId": "witness-b",
      "failureDomain": "venue-ups-b",
      "keyringFile": "/etc/stageforge/witness-b-keys.json"
    },
    {
      "url": "https://witness-c.example.net:8790",
      "witnessId": "witness-c",
      "failureDomain": "remote-witness-c",
      "keyringFile": "/etc/stageforge/witness-c-keys.json"
    }
  ]
}
